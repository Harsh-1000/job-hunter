#!/usr/bin/env bash
# Job Hunter helper: short commands for the Docker bot. Works from anywhere (also over SSH).
#   jobhunter help
set -euo pipefail

BOT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$BOT_DIR"

# A shell that hasn't picked up the "docker" group yet: re-run under it.
if ! docker info >/dev/null 2>&1 && getent group docker | grep -qw "$(id -un)"; then
    exec sg docker -c "$(printf '%q ' "$0" "$@")"
fi

export UID; export GID="$(id -g)"
admin() { docker compose exec -T job-hunter python -m app.admin "$@"; }
# old job-hunter images and build cache left behind by rebuilds (other projects' images are untouched)
clean_docker() {
    docker image prune -f >/dev/null 2>&1 || true            # dangling (<none>) images only
    docker builder prune -f --filter "until=24h" >/dev/null 2>&1 || true
}
# set KEY=VALUE in .env (replace or append); values here are token-like, no sed-special characters
set_env() {
    touch .env; chmod 600 .env
    if grep -q "^$1=" .env; then sed -i "s|^$1=.*|$1=$2|" .env; else printf '%s=%s\n' "$1" "$2" >> .env; fi
}
need_id() { [[ -n "${1:-}" ]] || { echo "Give the Telegram user ID, e.g.: jobhunter $CMD 123456789 (see: jobhunter users)"; exit 1; }; }

CMD="${1:-help}"
shift || true
case "$CMD" in
    # ---------------- health & logs
    health|status)
        echo "== Container"; docker compose ps --format '{{.Name}}: {{.Status}}' || true
        if [[ -f data/heartbeat ]]; then
            echo "== Heartbeat: $(( $(date +%s) - $(stat -c %Y data/heartbeat) ))s ago (healthy if under ~60s)"
        fi
        echo "== Bot stats"; admin stats 2>/dev/null || echo "   (bot not running)"
        echo "== Disk:   $(df -h "$BOT_DIR" | tail -1 | awk '{print $4" free"}') · data: $(du -sh data 2>/dev/null | cut -f1)"
        echo "== Uptime: $(uptime -p)"
        echo "== Last problems"
        grep -hE "WARNING|ERROR|CRITICAL" data/logs/bot.log* 2>/dev/null | tail -n 8 || echo "   none in the last 12 h"
        ;;
    logs)    docker compose logs -f --tail "${1:-100}" ;;
    log)     tail -n "${1:-100}" data/logs/bot.log ;;
    errors)  grep -hE "WARNING|ERROR|CRITICAL" data/logs/bot.log* 2>/dev/null | tail -n "${1:-50}" || echo "none" ;;
    scans)   grep -h "cycle:" data/logs/bot.log* 2>/dev/null | tail -n "${1:-20}" ;;

    # ---------------- users
    users)          admin users ;;
    approve)        need_id "${1:-}"; admin approve "$1" ;;
    block)          need_id "${1:-}"; admin block "$1" ;;
    make-admin)     need_id "${1:-}"; admin make-admin "$1" ;;
    stats)          admin stats ;;
    reset-cooldown) admin reset-cooldown ;;

    # ---------------- run the bot
    start)   docker compose up -d ;;
    stop)    docker compose stop ;;
    restart) docker compose restart ;;
    rebuild) docker compose up -d --build && clean_docker && docker compose ps ;;   # build runs all tests first
    update)  git pull --ff-only && docker compose up -d --build && clean_docker && docker compose ps ;;
    clean)
        find data/logs -type f ! -name bot.log -mmin +720 -delete 2>/dev/null || true
        clean_docker
        echo "== data: $(du -sh data | cut -f1) · free: $(df -h "$BOT_DIR" | tail -1 | awk '{print $4}')" ;;
    test)    if [[ -x .venv/bin/python ]]; then .venv/bin/python -m pytest -q "$@"
             else docker build --target test -t job-hunter:test .; fi ;;
    env)     "${EDITOR:-nano}" .env
             read -rp "Restart the bot to apply the changes? [Y/n] " a
             [[ "${a,,}" == "n" ]] || docker compose restart ;;
    backup)
        out="$HOME/jobhunter-backup-$(date +%F).tar.gz"
        (umask 077; tar -czf "$out" .env data/jobhunter.db data/users 2>/dev/null)
        echo "Backup: $out  (contains the bot token and users' resumes: keep it private)" ;;
    shell)   docker compose exec job-hunter bash ;;
    watchdog)
        line="*/10 * * * * $BOT_DIR/scripts/watchdog.sh >/dev/null 2>&1 # job-hunter-watchdog"
        case "${1:-status}" in
            install) (crontab -l 2>/dev/null | grep -v job-hunter-watchdog; echo "$line") | crontab -
                     echo "Watchdog installed: checks every 10 min, restarts the bot and messages you on Telegram." ;;
            remove)  (crontab -l 2>/dev/null | grep -v job-hunter-watchdog) | crontab -; echo "Watchdog removed." ;;
            run)     "$BOT_DIR/scripts/watchdog.sh" ;;
            *)       crontab -l 2>/dev/null | grep -q job-hunter-watchdog && echo "Watchdog: installed (every 10 min)" \
                         || echo "Watchdog: not installed (jobhunter watchdog install)"
                     [[ -f data/watchdog.alerted ]] && echo "Open alert since $(cat data/watchdog.alerted)" ;;
        esac ;;

    # ---------------- Claude judge (the `ai` container)
    ai)
        sub="${1:-status}"; shift || true
        case "$sub" in
            login)
                echo "Claude login: this prints a long-lived token for your Claude subscription (Pro/Max)."
                if command -v claude >/dev/null; then claude setup-token
                else docker compose run --rm -it --no-deps ai sh -c 'mkdir -p "$HOME" && claude setup-token'; fi
                read -rsp "Paste the token (sk-ant-oat...) here, input is hidden: " tok; echo
                [[ "$tok" =~ ^[A-Za-z0-9_-]{20,}$ ]] || { echo "That doesn't look like a token; nothing saved."; exit 1; }
                set_env CLAUDE_CODE_OAUTH_TOKEN "$tok"
                docker compose up -d ai && echo "Saved in .env. Check it: jobhunter ai test" ;;
            status) docker compose ps ai --format '{{.Name}}: {{.Status}}' || true; admin ai-status ;;
            test)   admin ai-test "${1:-}" ;;
            allow|block) need_id "${1:-}"; admin "ai-$sub" "$1" ;;
            logs)   docker compose logs -f --tail "${1:-100}" ai ;;
            *)      echo "Usage: jobhunter ai login|status|test [id]|allow <id>|block <id>|logs" ;;
        esac ;;

    help|-h|--help|*)
        [[ "$CMD" =~ ^(help|-h|--help)$ ]] || echo "Unknown command: $CMD"
        cat <<'TXT'
Job Hunter bot — helper commands (run from anywhere, also over SSH)

 Health & logs
   jobhunter health            container, heartbeat, stats, disk, last problems
   jobhunter logs [N]          live output (Ctrl+C to stop)
   jobhunter log [N]           last N lines of the current log (logs are kept 12 h)
   jobhunter errors [N]        recent warnings / errors (last 7 days)
   jobhunter scans [N]         last scan cycles (searches, new jobs, matches)

 Users
   jobhunter users             list everyone
   jobhunter approve <id>      let a waiting user in   ·   jobhunter block <id>
   jobhunter make-admin <id>   give admin rights
   jobhunter stats             totals   ·   jobhunter reset-cooldown   forget a LinkedIn rate-limit pause

 Bot
   jobhunter start | stop | restart
   jobhunter rebuild           rebuild the image (runs every test first), restart, clean old images
   jobhunter update            git pull + rebuild
   jobhunter clean             free space: old logs (>12 h), old images, build cache
   jobhunter test              run the test suite
   jobhunter env               edit .env, then restart
   jobhunter backup            save .env + database + resumes to ~/jobhunter-backup-<date>.tar.gz
   jobhunter watchdog install  check every 10 min from cron: restart + Telegram alert if the bot is down
   jobhunter watchdog [status|run|remove]

 Claude judge (AI)
   jobhunter ai login          connect your Claude subscription (once)
   jobhunter ai status         worker health, who may use it · jobhunter ai logs
   jobhunter ai test [id]      judge the newest job for a user, print Claude's verdict
   jobhunter ai allow <id>     let a user use Claude (uses your plan) · jobhunter ai block <id>
TXT
        ;;
esac
