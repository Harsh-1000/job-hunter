# ---------- Telegram ----------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Admin Telegram user IDs (comma separated). Empty: the first person to /start becomes admin.
ADMIN_IDS=
# approval = new users wait for an admin to approve them · open = anyone can use the bot
ACCESS_MODE=approval
MAX_USERS=50

# ---------- Scanning ----------
# Minutes between LinkedIn scans (minimum 2). Lower = faster alerts but more risk of LinkedIn rate limits.
SCAN_EVERY_MINUTES=3
# Default date filter is ⚡ Just posted: only jobs at most this many minutes old are sent
LIVE_MAX_AGE_MINUTES=30
# Pages (10 jobs each) fetched for a brand-new search; later scans only fetch what's new.
PAGES_FIRST_SCAN=3
# Max job alerts per user per cycle (the rest arrive next cycle)
MAX_PER_CYCLE=10
# Seconds a user must wait between manual /scan
MANUAL_SCAN_COOLDOWN_SECONDS=120
# Random pause between LinkedIn requests (seconds)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5
# After a LinkedIn rate limit, pause 10 -> 20 -> 40 ... up to this many minutes
MAX_COOLDOWN_MINUTES=60

# ---------- Misc ----------
MAX_RESUME_MB=5
# Log files in data/logs are rotated hourly and deleted after this many hours
LOG_RETENTION_HOURS=12
TIMEZONE=Asia/Kolkata

# ---------- Claude (AI job judge, the `ai` container) ----------
# Easiest: run `jobhunter ai login` (uses your Claude subscription via `claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key instead (pay per use). Leave both empty to use only the keyword match.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Max Claude calls per hour (protects your plan's limits); jobs over the budget use the keyword match.
AI_MAX_CALLS_PER_HOUR=120
# Max Claude calls per scan cycle (the rest wait for the next cycle)
AI_MAX_PER_CYCLE=20
